#include <bits/stdc++.h>
using namespace std;
typedef long long ll;
#define PII pair<int,int>
#define endl '\n'
const int INF = 1e9;
const int MAX = 1e5+5;
int n;
int a[MAX];
void qsort(int l,int r)
{
	if(l>=r)
		return;
	int i = l;
	int j = r;
	int q = a[(l+r)>>1];
	while(i<=j)
	{
		while(a[i]<q)
		{
			i++;
		}
		while(a[j]>q)
		{
			j--;
		}
		 if (i <= j) {         
            swap(a[i], a[j]);
            i++;
            j--;
        }
	}
	qsort(l,j);
	qsort(i,r);
}
int main(){
	ios::sync_with_stdio(false);
	cin.tie(nullptr);
	cout.tie(nullptr);
	cin>>n;
	for(int i = 0;i<n;i++)
		cin>>a[i];
	qsort(0,n-1);
	for(int i = 0;i<n;i++)
	{
		cout<<a[i]<<' ';
	}
}		